# ==============================================================================
# Enterprise AI Receptionist - Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# === Google Cloud & Vertex AI Runtime ===
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True
LOGS_BUCKET_NAME=

# === Google Sheets Integration ===
# ID of the Google Sheet used for WISMO order lookups
WISMO_SPREADSHEET_ID=your_wismo_google_sheet_id_here

# ID of the Google Sheet used for after-hours lead logging
SPREADSHEET_ID=your_leads_google_sheet_id_here

# Path to service account JSON key (optional if using ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# === Zendesk CRM Integration ===
ZENDESK_SUBDOMAIN=your_zendesk_subdomain
ZENDESK_EMAIL=agent@example.com
ZENDESK_API_TOKEN=your_zendesk_api_token
ZENDESK_DEFAULT_ASSIGNEE_ID=

# === Exa AI Search Integration (Optional Knowledge Base Search) ===
EXA_API_KEY=your_exa_api_key_here
